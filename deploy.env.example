# Copy this file to .env in the repository root before running Docker Compose.

# Pin the inference image for reproducible deployments.
VLLM_IMAGE=vllm/vllm-openai:v0.20.2
VLLM_MODEL=Qwen/Qwen3.5-2B
VLLM_MODEL_NAME=qwen3.5-2b
VLLM_API_KEY=replace-with-a-long-random-internal-token
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Optional for gated/private Hugging Face models. Qwen3.5-2B does not require it.
HF_TOKEN=

# Bind origins to localhost. Cloudflare reaches them over the private Compose network.
API_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1

# Seed the default project with ten approved TSS samples and an active profile.
DEMO_SEED_ENABLED=true

# Cloudflare Tunnel is enabled with: docker compose --profile cloudflare up -d --build
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.2
CLOUDFLARE_TUNNEL_TOKEN=replace-with-remotely-managed-tunnel-token

# This value is embedded into the frontend image at build time.
# Replace it with the public backend origin used by customer browsers.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# JSON list consumed by FastAPI CORS middleware.
ALLOWED_ORIGINS=["https://app.example.com"]
